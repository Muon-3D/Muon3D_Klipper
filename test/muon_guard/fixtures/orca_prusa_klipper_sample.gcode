; HAND-WRITTEN SAMPLE of what OrcaSlicer and PrusaSlicer (Klipper flavour)
; emit around a print. It is not an export; it lists the commands those
; slicers' Klipper start/end/layer-change templates produce, so that the
; gate is run over them. Add a line here when a slicer profile adds one.
M73 P0 R30
PRINT_START EXTRUDER=220 BED=60 MATERIAL=PETG PROBE_COUNT=5,5
M190 S60
M109 S220
G21
G90
M83
M220 S100
M221 S100
SET_PRESSURE_ADVANCE ADVANCE=0.04 SMOOTH_TIME=0.04
SET_VELOCITY_LIMIT ACCEL=5000 ACCEL_TO_DECEL=2500 SQUARE_CORNER_VELOCITY=5
M204 S5000
M205 X8.00 Y8.00
BED_MESH_PROFILE LOAD=default
EXCLUDE_OBJECT_DEFINE NAME=part_1 CENTER=100,90 POLYGON=[[90,80],[110,80],[110,100],[90,100]]
M486 S0 A"part_1"
SET_PRINT_STATS_INFO TOTAL_LAYER=100
G92 E0
G1 Z0.2 F600
G1 X100 Y90 F6000
EXCLUDE_OBJECT_START NAME=part_1
G1 X110 Y90 E1.5 F1800
G2 X110 Y100 I0 J5 E0.3
G3 X100 Y100 I-5 J0 E0.3
G10
G11
G4 P500
M106 S255
M106 P2 S128
SET_PRINT_STATS_INFO CURRENT_LAYER=2
;LAYER_CHANGE
G1 Z0.4 F600
TIMELAPSE_TAKE_FRAME
M117 Layer 2 of 100
M118 layer 2
M73 P50 R15
M104 S215
M140 S60
M141 S0
M191 S0
EXCLUDE_OBJECT_END NAME=part_1
M400
M107
M104 S0
M140 S0
G91
G1 Z10 F600
G90
M84
PRINT_END
