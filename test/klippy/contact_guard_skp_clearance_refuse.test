# Review #86 A: XY is refused after the resets.  Exits with an
# error; contact_guard_skp_clearance.test asserts the preamble.
DICTIONARY atmega2560.dict
CONFIG contact_guard.cfg
SHOULD_FAIL

G28
G90
G1 X50 Y50 Z5 F6000
CONTACT_GUARD_SIMULATE LOAD=0 DURATION=0.5
FORCE_MOVE STEPPER=stepper_z DISTANCE=-1 VELOCITY=5
CONTACT_GUARD_SIMULATE LOAD=300000 DURATION=0.5
ASSERT_GUARD ACTIVE=1 CONTACT=1
SET_KINEMATIC_POSITION Z=7
CONTACT_GUARD_SIMULATE LOAD=300000 DURATION=0.1
CONTACT_GUARD_SIMULATE LOAD=200000 DURATION=0.2
ASSERT_GUARD ACTIVE=1 CONTACT=1
SET_KINEMATIC_POSITION Z=8.5
CONTACT_GUARD_SIMULATE LOAD=200000 DURATION=0.2
G1 X100 Y50 F6000
