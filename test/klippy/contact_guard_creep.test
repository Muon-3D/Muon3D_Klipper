# Review #86 R3-b: a press creeping in at 22000 counts/s (about 1.1 um/s
# on the M1) for 120 s is not absorbed by drift following; it latches.
# contact_guard_creep_refuse.test is the refused XY.
DICTIONARY atmega2560.dict
CONFIG contact_guard.cfg

G28
G90
G1 X50 Y50 Z5 F6000
CONTACT_GUARD_SIMULATE LOAD=0 DURATION=0.5
CONTACT_GUARD_SIMULATE LOAD=0 DURATION=120 DRIFT=-22000
ASSERT_GUARD ACTIVE=1 CONTACT=1
