# Tests for loadcell sensors
DICTIONARY atmega2560.dict
CONFIG load_cell.cfg

# Start by homing the printer.
G28
G1 F6000

# Z / X / Y moves
G1 Z1
G1 X1
G1 Y1

# Run bed_mesh_calibrate
BED_MESH_CALIBRATE

# Move again
G1 Z5 X0 Y0

# Do regular probe
PROBE

# Move again
G1 Z9

# Exercise both timing paths, including the multi-sample retract loop.
PROBE LOW_LATENCY=0 SAMPLES=2 PROBE_TIMING=1
G1 Z9
PROBE LOW_LATENCY=1 SAMPLES=2 SETTLING_TIME=0.04 PROBE_TIMING=1
G1 Z9
PROBE_ACCURACY LOW_LATENCY=1 SAMPLES=3
G1 Z9
BED_MESH_CALIBRATE LOW_LATENCY=1
G1 Z9
G28 Z LOW_LATENCY=1 PROBE_TIMING=1
