# Review #86 D: XY is refused after the staircase.  Exits with an
# error.
DICTIONARY atmega2560.dict
CONFIG contact_guard.cfg
SHOULD_FAIL

G28
G90
G1 X50 Y50 Z5 F6000
CONTACT_GUARD_SIMULATE LOAD=0 DURATION=0.5
FORCE_MOVE STEPPER=stepper_z DISTANCE=-1 VELOCITY=5
CONTACT_GUARD_SIMULATE LOAD=80000 DURATION=0.6
CONTACT_GUARD_SIMULATE LOAD=160000 DURATION=0.6
CONTACT_GUARD_SIMULATE LOAD=240000 DURATION=0.6
CONTACT_GUARD_SIMULATE LOAD=320000 DURATION=0.6
G1 X100 Y50 F6000
