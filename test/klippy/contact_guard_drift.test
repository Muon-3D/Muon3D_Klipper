# Review #86 R2-1: drift alone, with nothing touching, never latches
# contact: 60 s toward pressing at the measured 9000 counts/s, then out
# 540000 toward unloading and back.
DICTIONARY atmega2560.dict
CONFIG contact_guard.cfg

G28
G90
G1 X50 Y50 Z20 F6000
CONTACT_GUARD_SIMULATE LOAD=0 DURATION=0.5
CONTACT_GUARD_SIMULATE LOAD=0 DURATION=60 DRIFT=-9000
ASSERT_GUARD ACTIVE=1 CONTACT=0
CONTACT_GUARD_SIMULATE LOAD=0 DURATION=60 DRIFT=9000
ASSERT_GUARD ACTIVE=1 CONTACT=0
CONTACT_GUARD_SIMULATE LOAD=0 DURATION=60 DRIFT=9000
ASSERT_GUARD ACTIVE=1 CONTACT=0
CONTACT_GUARD_SIMULATE LOAD=0 DURATION=60 DRIFT=-9000
ASSERT_GUARD ACTIVE=1 CONTACT=0
G1 X100 Y50 F6000
