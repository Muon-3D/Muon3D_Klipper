# KAN-828: the cutter press leaves a contact-level residual (150000
# counts) on the cell.  REZERO TRY=1 refuses it (contact level), and
# before KAN-828 the guard stayed latched until a full G28, so the park
# after the cut was refused.  Back at the pose it stood aside at, with Z
# untouched, ENABLE=1 re-seats the zero; a real press still latches.
DICTIONARY atmega2560.dict
CONFIG cut_filament.cfg

G28
G90
G1 X100 Y100 Z20 F6000
CONTACT_GUARD_SIMULATE LOAD=0 DURATION=0.5
_CUT_TEST RESIDUAL=150000
CUT_FILAMENT
ASSERT_CUT PRESS_Z=20 PARK_POS=135.000,63.000,140.000
ASSERT_GUARD ENABLED=1

G28
G1 X100 Y100 Z5 F6000
G1 Z1 F600
CONTACT_GUARD_SIMULATE LOAD=0 DURATION=1
CONTACT_GUARD_SIMULATE LOAD=200000 DURATION=0.1
ASSERT_GUARD ENABLED=1 ACTIVE=1 CONTACT=1
