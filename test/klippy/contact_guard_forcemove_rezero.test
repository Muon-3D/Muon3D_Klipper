# Review #86 B: REZERO is refused after FORCE_MOVE, though the
# toolhead still says Z 20.  Exits with an error at REZERO.
DICTIONARY atmega2560.dict
CONFIG contact_guard.cfg
SHOULD_FAIL

G28
G90
G1 X50 Y50 Z20 F6000
CONTACT_GUARD_SIMULATE LOAD=0 DURATION=0.5
FORCE_MOVE STEPPER=stepper_z DISTANCE=-20 VELOCITY=10
CONTACT_GUARD_SIMULATE LOAD=200000 DURATION=1
ASSERT_GUARD ACTIVE=1 CONTACT=1
SET_CONTACT_GUARD REZERO=1
