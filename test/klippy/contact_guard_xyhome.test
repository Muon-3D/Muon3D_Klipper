# Review #86 C: an X homing move does not re-zero on a held
# touch.  contact_guard_xyhome_refuse.test is the refused XY.
DICTIONARY atmega2560.dict
CONFIG contact_guard.cfg

G28
G90
G1 X50 Y50 Z5 F6000
CONTACT_GUARD_SIMULATE LOAD=0 DURATION=0.5
FORCE_MOVE STEPPER=stepper_z DISTANCE=-1 VELOCITY=5
CONTACT_GUARD_SIMULATE LOAD=200000 DURATION=0.5
ASSERT_GUARD ACTIVE=1 CONTACT=1
G28 X
CONTACT_GUARD_SIMULATE LOAD=200000 DURATION=0.5
ASSERT_GUARD ACTIVE=1 CONTACT=1
