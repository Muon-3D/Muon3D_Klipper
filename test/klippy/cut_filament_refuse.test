# KAN-1940: after CUT_FILAMENT, an XY jog with the nozzle on the plate is
# refused (cut_filament_protects.test checks the steps up to the jog)
DICTIONARY atmega2560.dict
CONFIG cut_filament.cfg
SHOULD_FAIL

G28
G90
G1 X100 Y100 Z20 F6000
CONTACT_GUARD_SIMULATE LOAD=0 DURATION=0.5
_CUT_TEST
CUT_FILAMENT
G28
G1 X100 Y100 Z5 F6000
G1 Z1 F600
CONTACT_GUARD_SIMULATE LOAD=0 DURATION=0.5
CONTACT_GUARD_SIMULATE LOAD=200000 DURATION=0.1
G1 X110 F6000
