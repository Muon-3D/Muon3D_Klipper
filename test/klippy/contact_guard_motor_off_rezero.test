# Review #86 R2-3, with home_rails homing: Z motor off, then REZERO on a
# held load is refused.  Exits with an error at REZERO.
DICTIONARY atmega2560.dict
CONFIG contact_guard.cfg
SHOULD_FAIL

G28
G90
G1 X50 Y50 Z20 F6000
CONTACT_GUARD_SIMULATE LOAD=0 DURATION=0.5
SET_STEPPER_ENABLE STEPPER=stepper_z ENABLE=0
CONTACT_GUARD_SIMULATE LOAD=200000 DURATION=1
ASSERT_GUARD ACTIVE=1 CONTACT=1
SET_CONTACT_GUARD REZERO=1 FORCE=1
